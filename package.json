{
  "name": "muz-bot-ds",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Discord music bot with yt-dlp",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "npm run build && node dist/src/deploy-commands.js",
    "test": "npm run build && node dist/tests/run.js",
    "test:integration": "npm run build && node dist/integration/smoke.js",
    "update:ytdlp": "npm run build && node dist/src/update-ytdlp.js",
    "setup:voice": "npm run build && node dist/src/setup-voice.js",
    "test:voice": "npm run build && node dist/integration/voice.js"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  }
}
