DISCORD_TOKEN=
CLIENT_ID=
# GUILD_ID=  # instant registration in a test server
# YT_DLP_PATH=  # optional override; otherwise managed Python venv is created
# FFMPEG_PATH=  # optional override for ffmpeg-static
# WATCH_TOGETHER_APP_ID=880218394199220334
# SMOKE_VIDEO_URL=  # optional URL for npm run test:integration
# WHISPER_MODEL=large-v3-turbo  # command STT; used by setup:voice
# WHISPER_WAKE_MODEL=small     # fast wake recognition; used by setup:voice
# VOICE_CPU_THREADS=4  # local inference threads, 1–8
# LAYA_MODEL_PATH=  # optional local Laya checkpoint directory; relative to project root
# VOICE_TEST_FIXTURES=  # local JSON manifest of WAV files for npm run test:voice
# VOICE_DEBUG=0  # action/confidence/player diagnostics, without audio or transcripts
# VOICE_TTS=1  # set 0 to disable local spoken confirmations; prepare with setup:tts
