# GUILD_ID=  # instant registration in a test server
# YT_DLP_PATH=  # optional override; otherwise managed Python venv is created
# FFMPEG_PATH=  # optional override for ffmpeg-static
# WATCH_TOGETHER_APP_ID=880218394199220334
# SMOKE_VIDEO_URL=  # optional URL for npm run test:integration
# WHISPER_MODEL=small  # used by setup:voice; multilingual Whisper, not small.en
# VOICE_CPU_THREADS=4  # local inference threads, 1–8
# VOICE_TEST_FIXTURES=  # local JSON manifest of WAV files for npm run test:voice
