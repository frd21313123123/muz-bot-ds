DISCORD_TOKEN=
CLIENT_ID=
# GUILD_ID=  # instant registration in a test server
# YT_DLP_PATH=  # optional override; otherwise managed Python venv is created
# FFMPEG_PATH=  # optional override for ffmpeg-static
# WATCH_TOGETHER_APP_ID=880218394199220334
# SMOKE_VIDEO_URL=  # optional URL for npm run test:integration
VOICE_PROFILE=light  # light: Groq + rules; heavy: Groq + local Laya
STT_PROVIDER=groq  # groq (default); local restores offline Whisper
GROQ_API_KEY=  # GroqCloud API key, required for cloud STT; keep only in .env
# Groq uses whisper-large-v3-turbo for cloud STT commands, language=ru
# WAKE_MODEL_PATH=models/wake-model  # local ONNX wake-word model directory (default: models/wake-model)
# WAKE_THRESHOLD=0.95  # wake-word detection sensitivity threshold (0.0-1.0, default: 0.95)
# WHISPER_LIGHT_MODEL=small  # multilingual tiny/base/small; rerun setup:voice after changing
# WHISPER_LIGHT_MODEL_PATH=  # optional prepared CTranslate2 INT8 directory; rerun setup:voice
# VOICE_TTS_ENGINE=bundled  # short ready-made clips; optional silero/piper for regeneration
# WHISPER_MODEL=large-v3-turbo  # local provider only: command STT; used by setup:voice
# WHISPER_WAKE_MODEL=small     # fast wake recognition; used by setup:voice
# VOICE_CPU_THREADS=4  # local inference threads, 1–8
# VOICE_DEVICE=cpu  # cuda enables NVIDIA GPU inference; rerun setup:voice when changing
# LAYA_MODEL_PATH=  # optional local Laya checkpoint directory; relative to project root
# VOICE_TEST_FIXTURES=  # local JSON manifest of WAV files for npm run test:voice
# VOICE_DEBUG=0  # action/confidence/player diagnostics, without audio or transcripts
# VOICE_NLI_LOG=0  # set 1 to store activated command transcripts for manual NLI labeling in .runtime/nli
# VOICE_TTS=1  # set 0 to disable local spoken confirmations; prepare with setup:tts
